BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Trading Configuration
SYMBOL=BTC/USDT
TIMEFRAME=5m
TRADE_AMOUNT_USDT=15.0

# Safety Modes
TESTNET=True
DRY_RUN=True

# Automated Risk Management Protections (Calibrated for $20 Account)
STOP_LOSS_PCT=0.015               # 1.5% fixed stop loss ($0.23 max loss on $15 trade)
TAKE_PROFIT_PCT=0.035             # 3.5% take profit target ($0.53 profit target)
TRAILING_STOP_ENABLED=True        # Dynamically lock in gains during winning runs
TRAILING_STOP_ACTIVATION_PCT=0.015 # Profit must reach +1.5% before trailing stop arms
TRAILING_STOP_CALLBACK_PCT=0.010  # Trail 1.0% below high-water mark peak price
MAX_DAILY_LOSS_USDT=1.00          # Circuit breaker: halt after $1.00 daily loss (5% of $20 account)
MIN_VOLUME_RATIO=0.80             # Candle volume must be >= 80% of 20-period Volume SMA
MIN_ATR_PCT=0.0020                # Minimum volatility: ATR(14) >= 0.20% of price (filters flat chop)
MIN_EMA_SPREAD_PCT=0.0005         # Minimum EMA separation (0.05%) to avoid flat micro-crosses
MIN_NOTIONAL_USDT=5.00            # Binance minimum order notional filter threshold
